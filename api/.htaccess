# Transmet l'en-tête Authorization à PHP (sinon Bearer token perdu sur Apache/CGI)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
</IfModule>

# Variante CGI/FastCGI
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Empêche l'accès direct aux fichiers sensibles.
# migrate.php est inclus : il s'exécute désormais en ligne de commande
# (`php api/migrate.php LE_TOKEN`), donc il n'a aucune raison d'être joignable
# par HTTP. Le bloquer ici vaut mieux que de le supprimer après usage — api/
# étant redéployé depuis le dépôt, la suppression ne survivait pas au push suivant.
<FilesMatch "^(config\.php|config\.sample\.php|schema\.sql|bootstrap\.php|migrate\.php)$">
  Require all denied
</FilesMatch>

# ─────────────────────────────────────────────────────────────────────────────
# Défense par extension, en complément de la liste nominative ci-dessus : tout
# fichier non exécutable déposé dans ce dossier est servi tel quel par Apache.
<FilesMatch "\.(sql|md|log|json|lock|ini|bak|old|orig|swp)$">
  Require all denied
</FilesMatch>

# Fichiers commençant par un point (.env, .git*, .htpasswd…).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

Options -Indexes
